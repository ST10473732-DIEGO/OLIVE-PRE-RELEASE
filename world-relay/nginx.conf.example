# Alternative: an existing nginx terminates TLS (certificate managed by you, e.g. certbot).
# Run the relay with: python3 -m olive.world_relay --host 127.0.0.1 --port 8765 --behind-proxy --trusted-proxy 127.0.0.1
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen 443 ssl;
    http2 off;
    server_name world-relay.example.com;
    ssl_certificate     /etc/letsencrypt/live/world-relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/world-relay.example.com/privkey.pem;
    access_log off;   # The relay logs its own anonymous connection events.

    location = /olive-world/1 {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;   # The relay pings every 20 s.
        proxy_send_timeout 120s;
        proxy_buffering off;
    }
    location = /healthz   { proxy_pass http://127.0.0.1:8765; }
    location = /readiness { proxy_pass http://127.0.0.1:8765; }
    location / { return 404; }
}
