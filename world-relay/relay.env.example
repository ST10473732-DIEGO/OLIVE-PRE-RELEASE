# OLIVE Connect World relay settings. Copy to relay.env. This file holds NO secrets:
# the relay has none (route credentials stay on the paired devices).

# The public hostname Caddy obtains a certificate for (DNS A/AAAA must point here).
OLIVE_WORLD_DOMAIN=world-relay.example.com

# Plaintext listener inside the container, reachable only by the TLS reverse proxy.
OLIVE_WORLD_RELAY_HOST=0.0.0.0
OLIVE_WORLD_RELAY_PORT=8765
OLIVE_WORLD_RELAY_BEHIND_PROXY=1
# The reverse proxy (fixed address on the compose network) may name the client address.
OLIVE_WORLD_RELAY_TRUSTED_PROXIES=172.30.57.2

# Limits (defaults shown). Per-address limits are generous because mobile carriers share addresses (CGNAT).
OLIVE_WORLD_RELAY_MAX_CONNECTIONS=2048
OLIVE_WORLD_RELAY_PER_IP_CONNECTIONS=64
OLIVE_WORLD_RELAY_LOG_LEVEL=INFO
