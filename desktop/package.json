{
  "name": "olive-desktop",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "dompurify": "3.4.15"
  },
  "type": "module",
  "main": "out/electron/main.cjs",
  "desktopName": "olive.desktop",
  "description": "OLIVE - local-first desktop AI assistant",
  "author": "Diego De Oliveira",
  "scripts": {
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:dir": "electron-builder --dir",
    "package:linux": "electron-builder --linux AppImage --x64",
    "package:win": "electron-builder --win nsis --x64",
    "package:mac": "electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.15",
    "lucide-react": "1.44.0",
    "monaco-editor": "0.56.0",
    "motion": "13.2.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yjs": "13.6.33",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "local.dmdo.desktop",
    "productName": "OLIVE",
    "executableName": "olive",
    "copyright": "Copyright © 2026 Diego De Oliveira",
    "beforePack": "scripts/require-backend.cjs",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "../packaging/electron"
    },
    "files": [
      "out/electron/**/*",
      "out/renderer/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "backend-artifact",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../assets/branding/olive.ico",
        "to": "olive.ico"
      },
      {
        "from": "../assets/branding/olive-256.png",
        "to": "olive-256.png"
      },
      {
        "from": "../LICENSE",
        "to": "legal/LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "legal/THIRD_PARTY-desktop.md"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/branding/olive-512.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Local-first desktop AI assistant",
      "artifactName": "OLIVE-${version}.${ext}",
      "desktop": {
        "entry": {
          "Name": "OLIVE",
          "GenericName": "AI Assistant",
          "Icon": "olive",
          "StartupWMClass": "olive",
          "StartupNotify": "true"
        }
      }
    },
    "appImage": {
      "executableArgs": []
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/branding/olive.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "OLIVE-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "OLIVE",
      "uninstallDisplayName": "OLIVE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "../packaging/electron/installer.nsh",
      "installerIcon": "../assets/branding/olive.ico",
      "uninstallerIcon": "../assets/branding/olive.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "../assets/branding/olive.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "../packaging/electron/entitlements.mac.plist",
      "entitlementsInherit": "../packaging/electron/entitlements.mac.inherit.plist",
      "identity": null,
      "notarize": false,
      "artifactName": "OLIVE-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "OLIVE ${version}",
      "artifactName": "OLIVE-${version}-${arch}.${ext}"
    }
  }
}
