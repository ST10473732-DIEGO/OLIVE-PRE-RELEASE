{
  "name": "olive-desktop",
  "version": "3.5.1-dev.1",
  "private": true,
  "overrides": {
    "dompurify": "3.4.15"
  },
  "type": "module",
  "main": "out/electron/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.15",
    "lucide-react": "1.44.0",
    "monaco-editor": "0.56.0",
    "motion": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "local.dmdo.desktop",
    "productName": "OLIVE",
    "beforePack": "scripts/require-backend.cjs",
    "extraResources": [
      {
        "from": "backend-artifact",
        "to": "backend"
      },
      {
        "from": "../assets/branding/olive.ico",
        "to": "olive.ico"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "out/package"
    },
    "win": {
      "icon": "../assets/branding/olive.ico",
      "target": "dir"
    }
  }
}
