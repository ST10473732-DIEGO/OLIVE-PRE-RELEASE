{
  "protocol": "olive-draw/1",
  "capability": "sync.draw",
  "frames": {"request": 15, "response": 16},
  "document_schemas": [1, 2],
  "limits": {
    "max_frame_bytes": 512000,
    "max_request_lifetime_seconds": 120,
    "future_tolerance_seconds": 5,
    "max_entries": 256,
    "max_request_bytes": 400000,
    "max_wants": 32,
    "asset_chunk_bytes": 262144,
    "max_asset_bytes": 48000000,
    "max_asset_transfers_per_peer": 2,
    "max_staged_bytes_per_peer": 96000000,
    "transfer_idle_seconds": 60,
    "max_rounds_per_pump": 64
  },
  "operations": {
    "hello": {"required": ["versions", "schemas"], "optional": []},
    "sync": {"required": ["epoch", "entries"], "optional": []},
    "asset": {"required": ["epoch", "transfer_id", "asset_id", "mime", "width", "height", "total_bytes", "count", "index", "data"],
              "optional": []}
  },
  "entry_forms": [["seq", "record"], ["seq", "purge"]],
  "purge": ["drawing_id", "at", "device"],
  "statuses": ["applied", "duplicate", "purged", "rejected"],
  "asset_statuses": ["partial", "stored", "exists", "rejected"],
  "errors": ["unsupported_protocol", "malformed_message", "source_mismatch", "wrong_target", "expired_request",
             "device_not_paired", "identity_mismatch", "permission_off", "capability_unavailable", "draw_unavailable",
             "payload_too_large", "rate_limited", "busy", "invalid_record", "drawing_too_large", "too_many_operations",
             "drawings_capacity", "invalid_image", "unsupported_image", "image_too_large", "checksum_mismatch"]
}
