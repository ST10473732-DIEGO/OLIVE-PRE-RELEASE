{
  "schema": "olive-runtime-manifest/2",
  "manifest_version": "1.0.0",
  "product_version": "1.0.0",
  "recorded": "2026-10-03",
  "note": "What OLIVE 1.0 first-run setup may download. An entry is installable only when it is enabled AND its source, checksum or registry digest, size, destination and reviewed licence are recorded (olive.services.runtime_manifest enforces this). Every value comes from primary evidence listed in the entry; nothing was guessed. Disabled entries say why. Licence fields are engineering evidence, not legal advice: owner/legal sign-off is tracked separately.",
  "profiles": {
    "core": {"label": "OLIVE Core", "includes": [], "summary": "Everyday local AI: chat, live answers, documents, the Agent Workspace, Notes, Draw and OLIVE Connect."},
    "creator": {"label": "OLIVE Creator", "includes": ["core"], "summary": "Core plus local image, speech and video generation."},
    "complete": {"label": "OLIVE Complete", "includes": ["creator"], "summary": "Creator plus MAX, UNCENSORED, vision, advanced coding and optional browser automation."}
  },
  "features": [
    {"id": "fast", "label": "FAST", "profile": "core", "requires": ["ollama-runtime", "model-fast"], "smoke": "fast"},
    {"id": "normal", "label": "NORMAL", "profile": "core", "requires": ["ollama-runtime", "model-normal"]},
    {"id": "now", "label": "NOW", "profile": "core", "requires": ["ollama-runtime", "model-now"], "note": "Uses the internet for public sources; the answer is written on this computer."},
    {"id": "deep", "label": "DEEP", "profile": "core", "requires": ["ollama-runtime", "model-normal"], "optional": ["model-embedding"], "note": "Without the embedding model, document search uses lexical retrieval."},
    {"id": "agent_workspace", "label": "Agent Workspace", "profile": "core", "requires": ["ollama-runtime", "model-normal"]},
    {"id": "notes", "label": "Notes", "profile": "core", "requires": []},
    {"id": "draw", "label": "Draw", "profile": "core", "requires": []},
    {"id": "connect", "label": "OLIVE Connect", "profile": "core", "requires": []},
    {"id": "connect_world", "label": "Connect World", "profile": "core", "requires": [], "note": "Needs a relay you run yourself."},
    {"id": "reimagine", "label": "REIMAGINE", "profile": "creator", "requires": ["image-engine", "image-model"]},
    {"id": "audio", "label": "AUDIO", "profile": "creator", "requires": ["audio-engine", "audio-model"]},
    {"id": "video", "label": "VIDEO", "profile": "creator", "requires": ["video-engine", "video-gguf-loader", "video-model"]},
    {"id": "image_to_video", "label": "Image to video", "profile": "creator", "requires": ["video-engine", "video-gguf-loader", "video-model"]},
    {"id": "long_video", "label": "Long-form video", "profile": "creator", "requires": ["video-engine", "video-gguf-loader", "video-model", "ffmpeg"]},
    {"id": "max", "label": "MAX", "profile": "complete", "requires": ["ollama-runtime", "model-max"]},
    {"id": "uncensored", "label": "UNCENSORED", "profile": "complete", "requires": ["ollama-runtime", "model-uncensored"]},
    {"id": "vision", "label": "Vision", "profile": "complete", "requires": ["ollama-runtime", "model-vision"]},
    {"id": "advanced_coding", "label": "Advanced coding", "profile": "complete", "requires": ["ollama-runtime", "model-coding"]},
    {"id": "browser_automation", "label": "Browser automation", "profile": "complete", "requires": ["playwright"], "optional_component": true, "note": "Optional. HTTP research works without it. Uses Chrome, Edge or Chromium already on this computer; no browser is downloaded."}
  ],
