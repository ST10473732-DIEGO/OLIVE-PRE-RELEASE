# systemd alternative to Docker: /etc/systemd/system/olive-world-relay.service
# Unpack the bundle to /opt/olive-world-relay first (no OLIVE source repository needed).
[Unit]
Description=OLIVE Connect World relay 1.0.0 (blind, stateless)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/olive-world-relay
ExecStart=/usr/bin/python3 -E -s -m olive.world_relay --host 127.0.0.1 --port 8765 --behind-proxy --trusted-proxy 127.0.0.1
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
