<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for a future Developer ID build of OLIVE (placeholder:
  nothing is signed or notarized in this repository yet).
  allow-jit / allow-unsigned-executable-memory: required by Electron's V8.
  disable-library-validation: the bundled Python loads third-party extension modules
  (cryptography, pydantic-core, ...). Review whether re-signing every bundled Mach-O
  with the OLIVE Team ID lets this be removed before the first notarized release.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
